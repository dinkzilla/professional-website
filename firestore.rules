rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The Google accounts that may change anything. Must match EDITOR_EMAILS in src/app/firebase.ts, and storage.rules.
    function isEditor() {
      return request.auth != null
        && request.auth.token.email in ['venablekd@gmail.com', 'dinkzilla@gmail.com']
        && request.auth.token.email_verified == true;
    }

    // Everyone can see the ratings; only the editor can add, edit or delete.
    match /movies/{movie} {
      allow read: if true;
      allow write: if isEditor();

      // Details of the audio reviews in Cloud Storage (storage.rules), and the edits made to them. Nobody else can see them yet.
      match /recordings/{recording} {
        allow read, write: if isEditor();
      }

      // Versions of the audio reviews published as podcast episodes. The backend makes their files.
      // Everyone can see the finished ones (below); the editor sees them all.
      match /published/{episode} {
        allow read, write: if isEditor();
      }

      // Each recording's waveform, for the editor. Only the backend makes them.
      match /waveforms/{recording} {
        allow read, delete: if isEditor();
      }
    }

    // Finished published episodes are public, in one movie or across them all (the list's audio badges).
    // Rules aren't filters, so a visitor's query must ask for status == 'done'.
    match /{path=**}/published/{episode} {
      allow read: if resource.data.status == 'done';
    }

    // private/tmdb holds the movie-search API key. Set it from the Firebase console or `npm run seed`.
    match /private/{document} {
      allow read: if isEditor();
    }
  }
}
