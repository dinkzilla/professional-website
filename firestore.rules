rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The one Google account that may change anything. Must match EDITOR_EMAIL in src/app/firebase.ts, and storage.rules.
    function isEditor() {
      return request.auth != null
        && request.auth.token.email == 'venablekd@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Everyone can see the ratings; only the editor can add, edit or delete.
    match /movies/{movie} {
      allow read: if true;
      allow write: if isEditor();

      // Details of the audio reviews in Cloud Storage (storage.rules), and the edits made to them. Nobody else can see them yet.
      match /reviews/{review} {
        allow read, write: if isEditor();
      }

      // Versions of the audio reviews published as podcast episodes. The backend makes their files.
      match /published/{episode} {
        allow read, write: if isEditor();
      }

      // Each recording's waveform, for the editor. Only the backend makes them.
      match /peaks/{review} {
        allow read, delete: if isEditor();
      }
    }

    // private/tmdb holds the movie-search API key. Set it from the Firebase console or `npm run seed`.
    match /private/{document} {
      allow read: if isEditor();
    }
  }
}
