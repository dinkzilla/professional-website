rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Must match EDITOR_EMAIL in src/app/firebase.ts, and firestore.rules.
    function isEditor() {
      return request.auth != null
        && request.auth.token.email == 'venablekd@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Audio reviews. Nobody else can hear them yet.
    match /movies/{movie}/recordings/{recording} {
      allow read, delete: if isEditor();
      allow create, update: if isEditor()
        && request.resource.size < 75 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // Published versions' files, made by the backend (functions/). It writes them; nobody else can.
    // Everyone can hear a finished one. The file, <episode>.m4a, is uploaded before its episode is
    // marked done, so it's the episode in Firestore that says whether it's finished.
    match /movies/{movie}/published/{file} {
      allow read: if isEditor()
        || firestore.get(/databases/(default)/documents/movies/$(movie)/published/$(file.split('\\.')[0])).data.status == 'done';
      allow delete: if isEditor();
    }
  }
}
