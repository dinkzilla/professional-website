{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist/holiday-romance/browser",
    "ignore": ["tmdb-key.txt", "seed/**", "3rdpartylicenses.txt"],
    "rewrites": [{ "source": "!**/*.@(js|css|woff2|txt)", "destination": "/index.html" }],
    "headers": [
      { "source": "!**/*.*", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      {
        "source": "**/*.@(js|css|woff2|webp)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
